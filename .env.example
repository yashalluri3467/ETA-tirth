# ETA Engine Environment Variables
# Copy this file to eta-service/.env and fill in the values

# Routing Engine — OSRM (self-hosted, primary)
OSRM_BASE_URL=http://localhost:5000

# Routing Engine — GraphHopper (optional)
GRAPHHOPPER_BASE_URL=http://localhost:8989
GRAPHHOPPER_API_KEY=

# Routing Engine — Google Routes API (optional)
GOOGLE_ROUTES_API_KEY=

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000
