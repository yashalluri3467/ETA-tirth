THIRTHTRACK_API_URL=http://localhost:3001
THIRTHTRACK_API_KEY=

# Routing Engine — OSRM (self-hosted)
OSRM_BASE_URL=http://localhost:5000

# Routing Engine — GraphHopper (optional)
