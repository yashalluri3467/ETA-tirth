GRAPHHOPPER_API_KEY=

# Routing Engine — Google Routes API (optional)
GOOGLE_ROUTES_API_KEY=

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000
